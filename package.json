{
  "name": "quai-cli-wallet",
  "version": "1.0.0",
  "description": "A CLI wallet for Quai Network",
  "main": "dist/index.js",
  "bin": {
    "quai-cli-wallet": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "package": "npm run build && pkg . --out-path bin",
    "package:mac": "npm run build && pkg . --targets node18-macos-arm64 --out-path bin",
    "package:linux": "npm run build && pkg . --targets node18-linux-x64 --out-path bin",
    "package:win": "npm run build && pkg . --targets node18-win-x64 --out-path bin",
    "package:all": "npm run build && pkg . --targets node18-macos-arm64,node18-linux-x64,node18-win-x64 --out-path bin"
  },
  "pkg": {
    "assets": [],
    "outputPath": "bin"
  },
  "keywords": [
    "quai",
    "wallet",
    "cli",
    "blockchain"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.0.0",
    "inquirer": "^9.2.12",
    "quais": "1.0.0-alpha.52"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "pkg": "^5.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  }
}
